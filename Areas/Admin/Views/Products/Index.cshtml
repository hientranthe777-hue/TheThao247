@model IEnumerable<TheThao247.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="mb-3">QUẢN LÝ SẢN PHẨM</h3>

<p>
    @Html.ActionLink("Thêm sản phẩm mới", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-striped align-middle">
    <thead style="background-color: #dff0d8;">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Hình ảnh</th>
            <th>Đơn giá</th>
            <th>Số lượng tồn</th>
            <th>Chủng loại</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.ProductName</td>
                <td style="width: 120px;">
                    @if (!string.IsNullOrEmpty(item.ProductImage))
                    {
                        <img src="@item.ProductImage" alt="@item.ProductName" class="img-thumbnail" style="max-height: 90px;" />
                    }
                </td>
                <td>@item.ProductPrice.ToString("N0") đ</td>
                <td>@item.Quantity</td>
                <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>